diff --git a/prototype/tests/test_release_accounting_v0_5.py b/prototype/tests/test_release_accounting_v0_5.py
new file mode 100644
--- /dev/null
+++ b/prototype/tests/test_release_accounting_v0_5.py
@@
+"""Release regressions for the faithful QUEST and emitted-CX accounting path."""
+
+import math
+
+import numpy as np
+
+import covq.noise as noise_mod
+from covq.circuits import lower_to_cx, resources
+from covq.noise import BlockLocalNoise, simulate_circuit_noisy
+from covq.quest import (PauliRotation, QuestResult, _apply_rotation, _dense,
+                        quest_circuit)
+from covq.sim import simulate
+
+
+def _same_state_up_to_phase(a, b, tol=1e-12):
+    a = np.asarray(a, dtype=complex) / np.linalg.norm(a)
+    b = np.asarray(b, dtype=complex) / np.linalg.norm(b)
+    return 1.0 - abs(np.vdot(a, b)) ** 2 <= tol
+
+
+def _one_weight_two_result(theta=0.37):
+    rot = PauliRotation(((0, "X"), (1, "Z")))
+    plus = np.ones(4, dtype=complex) / 2.0
+    state = _apply_rotation(plus, _dense(rot.axes, 2), theta)
+    return QuestResult(True, 0.0, [(rot, theta)], state, [1.0, 0.0], "converged")
+
+
+def test_quest_emitted_circuit_prepares_its_registered_input():
+    result = _one_weight_two_result()
+    got = simulate(lower_to_cx(quest_circuit(result, 2)))
+    assert _same_state_up_to_phase(got, result.state)
+
+
+def test_one_weight_two_pauli_rotation_emits_two_cx():
+    low = lower_to_cx(quest_circuit(_one_weight_two_result(), 2))
+    r = resources(low)
+    assert r["cx_count"] == 2
+
+
+def test_native_noise_is_applied_once_per_emitted_cx(monkeypatch):
+    low = lower_to_cx(quest_circuit(_one_weight_two_result(), 2))
+    calls = []
+    original = noise_mod._depolarize_pair_in_place
+
+    def counted(rho, qs, m, p):
+        calls.append(tuple(qs))
+        return original(rho, qs, m, p)
+
+    monkeypatch.setattr(noise_mod, "_depolarize_pair_in_place", counted)
+    simulate_circuit_noisy(
+        low,
+        BlockLocalNoise(edge_depolarizing={(0, 1): 0.02}),
+        n_data=2,
+    )
+    assert len(calls) == 2
+    assert calls == [(0, 1), (0, 1)]
